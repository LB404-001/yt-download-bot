FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir celery redis packaging requests yt-dlp mutagen

COPY tasks.py .

# не root
RUN useradd -m worker && mkdir -p /tmp/downloads && chown worker /tmp/downloads
USER worker

CMD ["celery", "-A", "tasks", "worker", "--loglevel=info", "--concurrency=4"]